{
  "name": "angular-doctor-repo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter @angular-doctor/core --filter @abiramcodes/angular-doctor run build",
    "test": "pnpm -r --filter @angular-doctor/core run test",
    "typecheck": "pnpm -r --filter @angular-doctor/core --filter @abiramcodes/angular-doctor run typecheck",
    "doctor": "node packages/angular-doctor/bin/angular-doctor.js",
    "doctor:fixture": "node packages/angular-doctor/bin/angular-doctor.js --verbose fixtures/sample-app",
    "docs:dev": "pnpm --filter @angular-doctor/docs dev",
    "docs:build": "pnpm --filter @angular-doctor/docs build",
    "docs:preview": "pnpm --filter @angular-doctor/docs preview",
    "publish:pkg": "pnpm --filter @abiramcodes/angular-doctor publish --access public",
    "fmt": "pnpm exec oxfmt",
    "lint:fix": "pnpm exec oxlint --fix-suggestions",
    "fix": "pnpm exec oxfmt && pnpm exec oxlint --fix-suggestions",
    "prepare": "pnpm exec husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.77.0",
    "oxlint": "1.93.0",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.6.0"
}
